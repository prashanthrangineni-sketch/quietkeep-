<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.pranix.quietkeep">

    <!-- ── Permissions ──────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera: photo capture via WebView file chooser + Capacitor Camera plugin -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Contacts: full phonebook sync via ContactsBridge -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Microphone: VoiceService native AudioRecord capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Audio focus for WebView Web Audio API on Android 14+ / ColorOS 14 / Vivo.
         Without this the OEM audio arbiter can deny the WebView audio session
         even when RECORD_AUDIO is granted. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground service base permission (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required on Android 14+ (API 34): startForeground() must declare type=microphone
         or AudioRecord.read() silently returns 0 bytes on every call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- FOREGROUND_SERVICE_LOCATION re-added 17 Oct 2026 (DRV-01) for BlackboxService.
         Unlike the 22 Aug removal below, this one IS started: Drive Mode
         (src/app/drive/page.jsx) calls QkBlackbox.start() on entry and stop()
         on exit, and the service calls startForeground() with type LOCATION
         (MICROPHONE added only when the cabin-audio opt-in is on AND
         RECORD_AUDIO is granted). Before the next Play release this needs the
         Foreground service declaration in Play Console (card DRV-09):
         use = "crash black box while the user is in Drive Mode". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Data-sync foreground type for KeepAliveService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Battery optimization exemption — prevents OplusHansManager UID freeze -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Usage stats: PerceptionPlugin.getForegroundApp() -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <!-- Push notifications: Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot receiver: restart VoiceService after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AlarmManager exact alarms (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- SEND_SMS: the SOS path only (activities/SosCountdownActivity). After
         the ten-second countdown the phone sends the emergency SMS itself, so
         SOS works with no internet and with the screen locked. Nothing else
         in the app sends SMS. Play Console: this needs the SMS permissions
         declaration under the "SOS / emergency" exception before release;
         without the permission at runtime the SOS falls back to opening the
         SMS composer with the message filled in. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Bluetooth Low Energy (OBD-II car reader, DRV-06) -->
    <!-- Android 12+ (API 31+) permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 11 and below (API <= 30) permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />


    <!-- Location: LocationService geo-trigger polling -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION removed for the v1.2.0 Play submission.
         Play's Location permissions declaration additionally requires a
         prominent in-app disclosure screen shown before the runtime prompt,
         plus a video of it. That screen does not exist yet, so the
         declaration cannot be completed truthfully. Returns in 1.3.0.
         Foreground location is unaffected: ACCESS_FINE_LOCATION,
         ACCESS_COARSE_LOCATION and FOREGROUND_SERVICE_LOCATION are retained,
         so Family Space "Share My Current Location" and SOS still work. -->
    <!-- HISTORY (superseded 17 Oct 2026 — see the DRV-01 note above):
         FOREGROUND_SERVICE_LOCATION removed 22 Aug 2026.
         LocationService is never started: startBackgroundServices() in
         src/lib/orchestrator.ts is the only caller of startLocationService(),
         and nothing in the app calls startBackgroundServices(). Verified on
         device — `dumpsys activity services com.pranix.quietkeep` returns
         zero LocationService records under every user path.
         Family Space "Share My Current Location", SOS and /geo all use
         @capacitor/geolocation on demand in the WebView, which needs only
         ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION (both retained above).
         Declaring a foreground service type the app never starts is a claim
         we cannot evidence, so the permission goes. -->

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="wa.me" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <!-- OEM battery optimization hints (4 major OEMs) -->

        <!-- Realme / OPPO / OnePlus (ColorOS / OxygenOS) -->
        <meta-data
            android:name="com.oplus.optimization.battery"
            android:value="no_optimize" />

        <!-- Xiaomi / Redmi / POCO (MIUI / HyperOS) -->
        <meta-data
            android:name="com.miui.autostart"
            android:value="1" />

        <!-- Vivo / iQOO (Funtouch OS / OriginOS) -->
        <meta-data
            android:name="com.vivo.notification.priority"
            android:value="1" />

        <!-- Huawei / Honor (EMUI / MagicUI) -->
        <meta-data
            android:name="com.huawei.keepalive"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.pranix.quietkeep" android:host="caller-context" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.CountdownActivity"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/AppTheme"
            android:exported="false" />

        <!-- SOS: ten-second countdown over the lock screen, then the phone
             sends the SMS itself. No AI, no internet. -->
        <activity
            android:name=".activities.SosCountdownActivity"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme"
            android:exported="false" />

        <!-- QuietKeepCallScreeningService: Track A1 incoming call context moat -->
        <service
            android:name=".services.QuietKeepCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- KeepAliveService: started before WebView load to block Hans UID freeze.
             IMPORTANCE_LOW prevents ColorOS from killing the notification channel. -->
        <service
            android:name=".services.KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- VoiceService: continuous mic → Sarvam STT → /api/voice/capture.
             foregroundServiceType="microphone" mandatory on Android 14+ (API 34). -->
        <service
            android:name=".services.VoiceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- BlackboxService: DRV-01 foreground service for rolling 60s crash buffer (.qkedr) -->
        <service
            android:name=".services.BlackboxService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|microphone" />

        <!-- LocationService declaration removed 22 Aug 2026 (it still is; the
             FOREGROUND_SERVICE_LOCATION permission came back on 17 Oct 2026
             for BlackboxService only). The class stays in the source tree
             for 1.3.0, when geo-trigger reminders return with a prominent
             disclosure screen — but an undeclared service cannot be started,
             and nothing starts it today. -->

        <!-- PaymentNotificationListener: Track A5 payment SMS & UPI notification auto-capture -->
        <service
            android:name=".services.PaymentNotificationListener"
            android:label="QuietKeep Expense Capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- BootReceiver: restarts VoiceService + LocationService after reboot -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- AlarmReceiver: fires when AlarmManager triggers a reminder -->
        <receiver
            android:name=".receivers.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ReminderTTSService: Speaks fired reminders out loud -->
        <service
            android:name=".services.ReminderTTSService"
            android:exported="false" />

        <!-- GeofenceBroadcastReceiver: Track A7 location keep geofence transition receiver -->
        <receiver
            android:name=".receivers.GeofenceBroadcastReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- QuickMicWidget: Track A3 Home Screen Mic Tap Target -->
        <receiver
            android:name=".widgets.QuickMicWidget"
            android:label="Talk to Aaria"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_mic_widget_info" />
        </receiver>

        <!-- QuietKeepVoiceAssistantService: Hardware power button / default assistant mapping -->
        <service
            android:name=".services.QuietKeepVoiceAssistantService"
            android:label="QuietKeep Voice Assistant"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/voice_interaction_service" />
        </service>

    </application>
</manifest>
