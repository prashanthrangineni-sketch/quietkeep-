    <color name="colorPrimaryDark">#4a4dd4</color>
    <color name="ic_launcher_background">#10b981</color>
    <string name="app_name" translatable="false">QuietKeep Business</string>
    <string name="custom_url_scheme">com.pranix.quietkeep</string>
